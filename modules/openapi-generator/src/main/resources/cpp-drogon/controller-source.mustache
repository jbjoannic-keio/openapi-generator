        typename {{classname}}Interface::{{operationId}}Response respVariant;
        service->{{vendorExtensions.operationIdSnakeCase}}(
            req, std::move(cb){{#pathParams}}, path_{{paramName}}{{/pathParams}}, respVariant
        );
        return;
{{/vendorExtensions.x-codegen-drogon-is-parsing-supported}}

    } catch (const std::exception& e) {
        // Operation-level exceptions (not parsing)
        handleOperationException(e, std::move(cb));
