                {{helpersNamespace}}::json::fromJson::fromJson(*json, {{paramName}});
            } else {
                Json::CharReaderBuilder b;
                std::unique_ptr<Json::CharReader> reader(b.newCharReader());
                Json::Value jsonBody;
                std::string errs;
                const char* data = req->bodyData();
                const size_t len = req->bodyLength();
                if (!reader->parse(data, data + len, &jsonBody, &errs)) {
                    throw std::invalid_argument("Invalid JSON body");
                }
                {{helpersNamespace}}::json::fromJson::fromJson(jsonBody, {{paramName}});
            }

            // Validate only if the type provides validate(); no-op otherwise
            {{helpersNamespace}}::autoValidate({{paramName}});
        } catch (const std::exception& e) {
            handleParsingException(e, std::move(cb));
            return;
        }
        {{/isPrimitiveType}}
        {{/bodyParam}}
        {{/hasBodyParam}}

        {{#hasQueryParams}}
        // --- query params ---
        {{#queryParams}}
        {{#isOptional}}
        {{{dataType}}} {{paramName}}{};   // std::optional<Inner>
        {
            const auto _q = req->getParameter("{{baseName}}");
            if (!_q.empty()) {
                typename {{{dataType}}}::value_type _tmp{};
                if (!{{helpersNamespace}}::fromStringValue(_q, _tmp)) {
                    throw std::invalid_argument("Invalid value for query parameter '{{baseName}}'");
                }
                {{paramName}} = std::move(_tmp);
            }
        }
        {{/isOptional}}
        {{^isOptional}}
        {{{dataType}}} {{paramName}}{};
        {
            const auto _q = req->getParameter("{{baseName}}");
            if (_q.empty()) {
