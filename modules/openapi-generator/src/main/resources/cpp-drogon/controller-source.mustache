{{#operations}}
    #include "{{classname}}.h"
    #include "{{prefix}}Helpers.h"
    #include <json/json.h>

    namespace {{apiNamespace}} {

    using namespace {{helpersNamespace}};
    {{#hasModelImport}}using namespace {{modelNamespace}};{{/hasModelImport}}

    const std::string {{classname}}::base = "{{basePathWithoutHost}}";

    /* ------------------------------------------------------------------ */
    /*  Generic helpers                                                    */
    /* ------------------------------------------------------------------ */

    void {{classname}}::handleParsingException(
    const std::exception& ex,
    std::function<void (const drogon::HttpResponsePtr &)> &&cb) const noexcept
        {
        auto [status, body] = handleParsingException(ex);
        auto resp = drogon::HttpResponse::newHttpResponse(body);
        resp->setStatusCode(status);
        cb(resp);
        }

        std::pair<drogon::HttpStatusCode, std::string>
    {{classname}}::handleParsingException(const std::exception& ex) const noexcept
        {
        // classify without rethrowing
        if (dynamic_cast<const Json::Exception*>(&ex))
        return {drogon::k400BadRequest, ex.what()};
        if (dynamic_cast<const ValidationException*>(&ex))
        return {drogon::k400BadRequest, ex.what()};
        return {drogon::k500InternalServerError, ex.what()};
        }


        void {{classname}}::handleOperationException(
        const std::exception& ex,
        std::function<void (const drogon::HttpResponsePtr &)> &&cb) const noexcept
        {
        auto [status, body] = handleOperationException(ex);
        auto resp = drogon::HttpResponse::newHttpResponse(body);
        resp->setStatusCode(status);
        cb(resp);
        }

        std::pair<drogon::HttpStatusCode, std::string>
    {{classname}}::handleOperationException(const std::exception& ex) const noexcept {
        return {drogon::k500InternalServerError, ex.what()};
        }

        /* ------------------------------------------------------------------ */
        /*  One method per operation                                          */
        /* ------------------------------------------------------------------ */
    {{#operation}}
            /* ---------- {{operationId}} ---------- */
            void {{classname}}::{{vendorExtensions.operationIdSnakeCase}}_handler(
            const drogon::HttpRequestPtr& req,
            std::function<void (const drogon::HttpResponsePtr &)> &&cb
        {{#pathParams}}, const {{{dataType}}}& path_{{paramName}}{{/pathParams}}
            ) {
            try {
        {{#vendorExtensions.x-codegen-drogon-is-parsing-supported}}
                /* -------- parameter extraction -------- */
            {{#hasBodyParam}}
                {{#bodyParam}}
                    {{^isPrimitiveType}}
                        {{baseType}} {{paramName}};
                            try {
                            Json::Value jsonBody;
                            Json::Reader reader;
                            if (!reader.parse(req->getBody(), jsonBody))
                            throw std::invalid_argument("Invalid JSON body");
                            from_json(jsonBody, {{paramName}});
                        {{paramName}}.validate();
                            } catch (const std::exception& e) {
                            handleParsingException(e, std::move(cb));
                            return;
                            }
                    {{/isPrimitiveType}}
                {{/bodyParam}}
            {{/hasBodyParam}}

            {{#hasQueryParams}}
                {{#queryParams}}
                        std::optional<{{{dataType}}}> {{paramName}};
                        {
                        auto _q = req->getParameter("{{baseName}}");
                        if (!_q.empty()) {
                    {{{dataType}}} tmp;
                        if (fromStringValue(_q, tmp))
                    {{paramName}} = tmp;
                        }
                        }
                {{/queryParams}}
            {{/hasQueryParams}}

            {{#hasHeaderParams}}
                {{#headerParams}}
                        std::string header_{{paramName}} = req->getHeader("{{baseName}}");
                    {{#isPrimitiveType}}
                        {{#isInteger}} std::int64_t {{paramName}} = std::stoll(header_{{paramName}}); {{/isInteger}}
                        {{#isNumber}}  double       {{paramName}} = std::stod (header_{{paramName}}); {{/isNumber}}
                        {{#isBoolean}} bool         {{paramName}} = (header_{{paramName}}=="true" || header_{{paramName}}=="1"); {{/isBoolean}}
                        {{#isString}}  std::string  {{paramName}} = header_{{paramName}}; {{/isString}}
                    {{/isPrimitiveType}}
                {{/headerParams}}
            {{/hasHeaderParams}}

                /* -------- delegate to service -------- */
            {{operationId}}Response respVariant;
                service->{{vendorExtensions.operationIdSnakeCase}}(
            {{#allParams}}
                {{#isHeaderParam}}{{paramName}}{{/isHeaderParam}}
                {{#isQueryParam}}{{paramName}}{{/isQueryParam}}
                {{#isPathParam}}path_{{paramName}}{{/isPathParam}}
                {{#isBodyParam}}{{paramName}}{{/isBodyParam}}{{^-last}}, {{/-last}}
            {{/allParams}}
                , respVariant);

                /* -------- serialize & return -------- */
                auto resp = {{helpersNamespace}}::variantToHttp(respVariant);
                cb(resp);
        {{/vendorExtensions.x-codegen-drogon-is-parsing-supported}}

        {{^vendorExtensions.x-codegen-drogon-is-parsing-supported}}
                /* Fallback: give raw request to service (but still pass path params). A param is a form field, a file upload or cookie param. */
            /*Or any other content that is not handled.*/
            {{operationId}}Response respVariant;
                service->{{vendorExtensions.operationIdSnakeCase}}(
                req, std::move(cb){{#pathParams}}, path_{{paramName}}{{/pathParams}}, respVariant);
        {{/vendorExtensions.x-codegen-drogon-is-parsing-supported}}

            } catch (const std::exception& e) {
            auto resp = drogon::HttpResponse::newHttpResponse(e.what());
            resp->setStatusCode(drogon::k500InternalServerError);
            cb(resp);
            }
            }
    {{/operation}}

        void {{classname}}::{{classnameSnakeLowerCase}}_default_handler(
        const drogon::HttpRequestPtr& /*req*/,
        std::function<void (const drogon::HttpResponsePtr &)> &&cb)
        {
        auto resp = drogon::HttpResponse::newHttpResponse("The requested method does not exist");
        resp->setStatusCode(drogon::k404NotFound);
        cb(resp);
        }

        } // namespace {{apiNamespace}}
{{/operations}}
