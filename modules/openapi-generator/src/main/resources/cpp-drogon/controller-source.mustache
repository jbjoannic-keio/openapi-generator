            }
            if (!{{helpersNamespace}}::fromStringValue(_q, {{paramName}})) {
                throw std::invalid_argument("Invalid value for query parameter '{{baseName}}'");
            }
        }
        {{/isOptional}}
        {{/queryParams}}
        {{/hasQueryParams}}

        {{#hasHeaderParams}}
        // --- header params ---
        {{#headerParams}}
        {{#isOptional}}
        {{{dataType}}} {{paramName}}{};   // std::optional<Inner>
        {
            const auto _h = req->getHeader("{{baseName}}");
            if (!_h.empty()) {
                typename {{{dataType}}}::value_type _tmp{};
                if (!{{helpersNamespace}}::fromStringValue(_h, _tmp)) {
                    throw std::invalid_argument("Invalid value for header '{{baseName}}'");
                }
                {{paramName}} = std::move(_tmp);
            }
        }
        {{/isOptional}}
        {{^isOptional}}
        {{{dataType}}} {{paramName}}{};
        {
            const auto _h = req->getHeader("{{baseName}}");
            if (_h.empty()) {
                throw std::invalid_argument("Missing required header '{{baseName}}'");
            }
            if (!{{helpersNamespace}}::fromStringValue(_h, {{paramName}})) {
                throw std::invalid_argument("Invalid value for header '{{baseName}}'");
            }
        }
        {{/isOptional}}
        {{/headerParams}}
        {{/hasHeaderParams}}

        /* -------- delegate to service -------- */
        typename {{classname}}Interface::{{operationId}}Response respVariant;
        service->{{vendorExtensions.operationIdSnakeCase}}(
            {{#allParams}}
            {{#isHeaderParam}}{{paramName}}{{/isHeaderParam}}
            {{#isQueryParam}}{{paramName}}{{/isQueryParam}}
            {{#isPathParam}}path_{{paramName}}{{/isPathParam}}
            {{#isBodyParam}}{{paramName}}{{/isBodyParam}}{{^-last}}, {{/-last}}
            {{/allParams}}
            {{#hasParams}}, {{/hasParams}}
            respVariant
        );

        /* -------- serialize & return -------- */
        auto resp = {{helpersNamespace}}::variantToHttp(respVariant);
        cb(resp);
{{/vendorExtensions.x-codegen-drogon-is-parsing-supported}}

{{^vendorExtensions.x-codegen-drogon-is-parsing-supported}}
        // Fallback: give raw request to service (e.g., multipart/form-data, file).
