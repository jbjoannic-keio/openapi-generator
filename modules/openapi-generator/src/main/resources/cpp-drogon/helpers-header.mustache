// ---------- validate() detection and helper ----------
namespace detail {
    template<class T, class = void>
    struct has_member_validate : std::false_type {};
    template<class T>
    struct has_member_validate<T, std::void_t<decltype(std::declval<const T&>().validate())>> : std::true_type {};
}

template<class T>
inline void autoValidate(const T& v)
{
    if constexpr (detail::has_member_validate<T>::value) {
        v.validate();
    }
}

/* =======================================================================
 *  3)  Response variant → drogon::HttpResponsePtr
 *      (tuple<Status, ContentType, Body> | pair<Status, Body> | status-only)
 * ===================================================================== */

namespace detail {
inline drogon::HttpResponsePtr badRequest(const std::string& what) {
    auto r = drogon::HttpResponse::newHttpResponse();
    r->setStatusCode(drogon::k400BadRequest);
    r->setContentTypeCode(drogon::CT_TEXT_PLAIN);
    r->setBody(what);
    return r;
}
} // namespace detail

template<drogon::HttpStatusCode S>
inline drogon::HttpResponsePtr makeResponse(std::integral_constant<drogon::HttpStatusCode, S>)
{
    auto resp = drogon::HttpResponse::newHttpResponse();
    resp->setStatusCode(S);
    return resp;
}

// Backward‑compat: pair<Status, Body> → JSON response
template<drogon::HttpStatusCode S, class Body>
inline drogon::HttpResponsePtr makeResponse(
    const std::pair<std::integral_constant<drogon::HttpStatusCode, S>, Body>& p)
{
    auto resp = drogon::HttpResponse::newHttpJsonResponse(toJson(p.second));
    resp->setStatusCode(S);
    return resp;
}

// tuple<Status, ContentType, Body> → typed response
template<drogon::HttpStatusCode S, drogon::ContentType C, class Body>
inline drogon::HttpResponsePtr makeResponse(
    const std::tuple<
        std::integral_constant<drogon::HttpStatusCode, S>,
        std::integral_constant<drogon::ContentType, C>,
        Body
    >& t)
{
    auto resp = drogon::HttpResponse::newHttpResponse();
    resp->setStatusCode(S);
    resp->setContentTypeCode(C);

    const auto& body = std::get<2>(t);
    if constexpr (C == drogon::CT_APPLICATION_JSON)
    {
        resp->setBody(json::dumpJson(json::toJson::toJson(body)));
    }
    else
    {
        if constexpr (std::is_same_v<Body, std::string>) {
            resp->setBody(body);
        } else if constexpr (std::is_same_v<Body, std::string_view>) {
            resp->setBody(std::string(body));
        } else if constexpr (std::is_same_v<Body, std::vector<std::uint8_t>>) {
            resp->setBody(std::string(reinterpret_cast<const char*>(body.data()), body.size()));
        } else {
            // Fallback: try JSON serialization then set that string
            resp->setBody(json::dumpJson(json::toJson::toJson(body)));
        }
    }
    return resp;
}


// tuple<Status, ContentType, Body> → typed response
template<drogon::HttpStatusCode S, drogon::ContentType C, class Body, class Headers>
inline drogon::HttpResponsePtr makeResponse(
    const std::tuple<
        std::integral_constant<drogon::HttpStatusCode, S>,
        std::integral_constant<drogon::ContentType, C>,
        Body,
        Headers
    >& t)
{
    auto resp = drogon::HttpResponse::newHttpResponse();
    resp->setStatusCode(S);
    resp->setContentTypeCode(C);

    const auto& body = std::get<2>(t);
    if constexpr (C == drogon::CT_APPLICATION_JSON)
    {
        resp->setBody(json::dumpJson(json::toJson::toJson(body)));
    }
    else
    {
        if constexpr (std::is_same_v<Body, std::string>) {
            resp->setBody(body);
        } else if constexpr (std::is_same_v<Body, std::string_view>) {
            resp->setBody(std::string(body));
        } else if constexpr (std::is_same_v<Body, std::vector<std::uint8_t>>) {
            resp->setBody(std::string(reinterpret_cast<const char*>(body.data()), body.size()));
        } else {
            // Fallback: try JSON serialization then set that string
            resp->setBody(json::dumpJson(json::toJson::toJson(body)));
        }
    }

    const auto& headers = std::get<3>(t);
    for (auto&& [key, value] : headers.toArray()) {
        resp->addHeader(key, value);
    }
    return resp;
}

struct ToHttpVisitor {
    template<class Alt>
    drogon::HttpResponsePtr operator()(Alt&& alt) const
    {
        return makeResponse(std::forward<Alt>(alt));
    }
};

template<class Variant>
inline drogon::HttpResponsePtr toHttpResponse(const Variant& v)
{
    return std::visit(ToHttpVisitor{}, v);
}

// Legacy alias (some older controllers might use this name)
template<class Variant>
inline drogon::HttpResponsePtr variantToHttp(const Variant& v)
{
    return toHttpResponse(v);
}

