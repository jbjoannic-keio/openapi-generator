namespace sfinae_helpers
{
    struct NoType {};
    template <typename T1, typename T2> NoType operator==(const T1&, const T2&);

    template <typename T1, typename T2> class EqualsOperatorAvailable
    {
    public:
        enum
        {
            value = !std::is_same<
                        decltype(std::declval<T1>() == std::declval<T2>()),
                        NoType>::value
        };
    };
} // namespace sfinae_helpers

/// Determine if a vector contains only unique elements (requires ==).
template <typename T>
bool hasOnlyUniqueItems(const std::vector<T>& vec)
{
    static_assert(sfinae_helpers::EqualsOperatorAvailable<T, T>::value,
                  "hasOnlyUniqueItems<T> requires operator==.");
    if (vec.size() <= 1)
        return true;

    for (size_t i = 0; i + 1 < vec.size(); ++i)
        for (size_t j = i + 1; j < vec.size(); ++j)
            if (vec[i] == vec[j])
                return false;

    return true;
}

/// Variant for std::set (always unique by definition).
template <typename T>
bool hasOnlyUniqueItems(const std::set<T>&)
{
    return true;
}

/* ----- string‑conversion helpers (declared; implemented in .cpp) ---- */
std::string toStringValue(const std::string &value);
std::string toStringValue(const int32_t value);
std::string toStringValue(const int64_t value);
std::string toStringValue(const bool    value);
std::string toStringValue(const float   value);
std::string toStringValue(const double  value);

bool fromStringValue(const std::string &inStr, std::string &value);
bool fromStringValue(const std::string &inStr, int32_t    &value);
bool fromStringValue(const std::string &inStr, int64_t    &value);
bool fromStringValue(const std::string &inStr, bool       &value);
bool fromStringValue(const std::string &inStr, float      &value);
bool fromStringValue(const std::string &inStr, double     &value);

template<typename T>
bool fromStringValue(const std::vector<std::string> &inStr,
                     std::vector<T> &value)
{
    try
    {
        for (const auto & item : inStr)
        {
            T tmp{};
            if (fromStringValue(item, tmp))
                value.push_back(tmp);
        }
    }
    catch (...)
    {
        return false;
    }
    return !value.empty();
}

template<typename T>
bool fromStringValue(const std::string &inStr,
                     std::vector<T> &value,
                     char separator = ',')
{
    std::vector<std::string> parts;
    std::istringstream       ss(inStr);
    std::string              s;
    while (std::getline(ss, s, separator))
        parts.push_back(s);

    return fromStringValue(parts, value);
}

/* =======================================================================
 *  2)  JSON helpers (header‑only; used by controllers & models)
 * ===================================================================== */

inline std::string dumpJson(const Json::Value& v)
{
    Json::StreamWriterBuilder w;
    w["indentation"] = ""; // compact
    return Json::writeString(w, v);
}

// Base overloads
inline Json::Value toJson(const Json::Value& v) { return v; }
inline Json::Value toJson(const std::string& s) { return Json::Value(s); }
inline Json::Value toJson(const char* s)        { return Json::Value(s ? s : ""); }
inline Json::Value toJson(std::nullptr_t)       { return Json::Value(); }
inline Json::Value toJson(bool b)               { return Json::Value(b); }
inline Json::Value toJson(std::int32_t n)       { return Json::Value(static_cast<Json::Int>(n)); }
inline Json::Value toJson(std::int64_t n)       { return Json::Value(static_cast<Json::Int64>(n)); }
inline Json::Value toJson(double d)             { return Json::Value(d); }

// Containers
template<class T>
Json::Value toJson(const std::vector<T>& xs)
{
    Json::Value a(Json::arrayValue);
    for (const auto& x : xs) a.append(toJson(x));
    return a;
}
template<class V>
Json::Value toJson(const std::map<std::string,V>& m)
{
    Json::Value o(Json::objectValue);
    for (const auto& kv : m) o[kv.first] = toJson(kv.second);
    return o;
}

// Detection helpers for models
namespace detail {
    template<class T, class = void>
    struct has_member_to_json : std::false_type {};
    template<class T>
    struct has_member_to_json<T, std::void_t<decltype(std::declval<const T&>().to_json())>> : std::true_type {};

    template<class T, class = void>
    struct has_member_toJson : std::false_type {};
    template<class T>
    struct has_member_toJson<T, std::void_t<decltype(std::declval<const T&>().toJson())>> : std::true_type {};

    template<class T, class = void>
    struct has_free_to_json : std::false_type {};
    template<class T>
    struct has_free_to_json<T, std::void_t<decltype(
        to_json(std::declval<Json::Value&>(), std::declval<const T&>())
    )>> : std::true_type {};
}

// Unify model → Json::Value for any model type T:
// 1) T::to_json()          → use it
// 2) T::toJson()           → use it
// 3) free to_json(j, T)    → call it and return j
template<class T>
Json::Value toJson(const T& t)
{
    if constexpr (detail::has_member_to_json<T>::value) {
        return t.to_json();
    } else if constexpr (detail::has_member_toJson<T>::value) {
        return t.toJson();
    } else if constexpr (detail::has_free_to_json<T>::value) {
        Json::Value j;
        to_json(j, t);  // ADL
        return j;
    } else {
        // Fallback for unsupported types:
        return Json::Value(Json::objectValue);
    }
}

/* =======================================================================
 *  3)  Response variant → drogon::HttpResponsePtr
 *      (tuple<Status, ContentType, Body> | pair<Status, Body> | status-only)
 * ===================================================================== */

template<drogon::HttpStatusCode S>
inline drogon::HttpResponsePtr makeResponse(std::integral_constant<drogon::HttpStatusCode, S>)
{
    auto resp = drogon::HttpResponse::newHttpResponse();
    resp->setStatusCode(S);
    return resp;
}

// Backward‑compat: pair<Status, Body> → JSON response
template<drogon::HttpStatusCode S, class Body>
inline drogon::HttpResponsePtr makeResponse(
    const std::pair<std::integral_constant<drogon::HttpStatusCode, S>, Body>& p)
{
    auto resp = drogon::HttpResponse::newHttpJsonResponse(toJson(p.second));
    resp->setStatusCode(S);
    return resp;
}

// tuple<Status, ContentType, Body> → typed response
template<drogon::HttpStatusCode S, drogon::ContentType C, class Body>
inline drogon::HttpResponsePtr makeResponse(
    const std::tuple<
        std::integral_constant<drogon::HttpStatusCode, S>,
        std::integral_constant<drogon::ContentType, C>,
        Body
    >& t)
{
    auto resp = drogon::HttpResponse::newHttpResponse();
    resp->setStatusCode(S);
    resp->setContentTypeCode(C);

    const auto& body = std::get<2>(t);
    if constexpr (C == drogon::CT_APPLICATION_JSON)
    {
        resp->setBody(dumpJson(toJson(body)));
    }
    else
    {
        if constexpr (std::is_same_v<Body, std::string>) {
            resp->setBody(body);
        } else if constexpr (std::is_same_v<Body, std::string_view>) {
            resp->setBody(std::string(body));
        } else if constexpr (std::is_same_v<Body, std::vector<std::uint8_t>>) {
            resp->setBody(std::string(reinterpret_cast<const char*>(body.data()), body.size()));
        } else {
            // Fallback: try JSON serialization then set that string
            resp->setBody(dumpJson(toJson(body)));
        }
    }
    return resp;
}

struct ToHttpVisitor {
    template<class Alt>
    drogon::HttpResponsePtr operator()(Alt&& alt) const
    {
        return makeResponse(std::forward<Alt>(alt));
    }
};

template<class Variant>
inline drogon::HttpResponsePtr toHttpResponse(const Variant& v)
{
    return std::visit(ToHttpVisitor{}, v);
}

// Legacy alias (some older controllers might use this name)
template<class Variant>
inline drogon::HttpResponsePtr variantToHttp(const Variant& v)
{
    return toHttpResponse(v);
}

