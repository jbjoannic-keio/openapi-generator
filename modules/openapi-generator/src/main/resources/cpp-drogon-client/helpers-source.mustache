#include "{{prefix}}Helpers.h"

#include <regex>
#include <limits>
#include <algorithm>
#include <cctype>   // <-- for std::tolower

namespace {{helpersNamespace}}
{

// ─────────────────────────────────────────────────────────────────────────────
//  RFC 3339 validation
// ─────────────────────────────────────────────────────────────────────────────

namespace {
    // Anchored patterns; use regex_match (not search)
    static const std::regex kRfc3339Date(R"(^(\d{4})\-(\d{2})\-(\d{2})$)");
    static const std::regex kRfc3339DateTime(
        R"(^(\d{4})\-(\d{2})\-(\d{2})[Tt](\d{2}):(\d{2}):(\d{2})(\.\d+)?([Zz]|([\+\-])(\d{2}):(\d{2}))$)"
    );

    // Determine if given year is a leap year
    // RFC 3339, Appendix C
    inline bool isLeapYear(const uint16_t year) {
        return (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0));
    }

    inline bool validateDateValues(const uint16_t year, const uint16_t month, const uint16_t day) {
        return !(
            (month == 0 || month > 12)
            || (day == 0)
            || (month == 2 && day > (28 + (isLeapYear(year) ? 1 : 0)))
            || (month <= 7 && day > (30 + month % 2))
            || (month >= 8 && day > (31 - month % 2))
        );
    }

    inline bool validateTimeValues(const uint16_t hours, const uint16_t minutes, const uint16_t seconds) {
        // seconds may be 60 for leap seconds
        return (hours <= 23) && (minutes <= 59) && (seconds <= 60);
    }
}

bool validateRfc3339_date(const std::string& str) {
    std::smatch m;
    if (!std::regex_match(str, m, kRfc3339Date)) return false;
    return validateDateValues(
        static_cast<uint16_t>(std::stoi(m[1])),
        static_cast<uint16_t>(std::stoi(m[2])),
        static_cast<uint16_t>(std::stoi(m[3]))
    );
}

bool validateRfc3339_date_time(const std::string& str) {
    std::smatch m;
    if (!std::regex_match(str, m, kRfc3339DateTime)) return false;
    return validateDateValues(
               static_cast<uint16_t>(std::stoi(m[1])),
               static_cast<uint16_t>(std::stoi(m[2])),
               static_cast<uint16_t>(std::stoi(m[3]))
           )
        && validateTimeValues(
               static_cast<uint16_t>(std::stoi(m[4])),
               static_cast<uint16_t>(std::stoi(m[5])),
               static_cast<uint16_t>(std::stoi(m[6]))
           );
}


} // namespace {{helpersNamespace}}
