/* ----- string‑conversion helpers (declared; implemented in .cpp) ---- */
std::string toStringValue(const std::string &value);
std::string toStringValue(const int32_t value);
std::string toStringValue(const int64_t value);
std::string toStringValue(const bool    value);
std::string toStringValue(const float   value);
std::string toStringValue(const double  value);
std::string toStringValue(const size_t value);

template<typename T>
std::string toStringValue(const std::optional<T> &oValue)
{
    return oValue.has_value() ? toStringValue(oValue.value()) : "";
}

bool fromStringValue(const std::string &inStr, std::string &value);
bool fromStringValue(const std::string &inStr, int32_t    &value);
bool fromStringValue(const std::string &inStr, int64_t    &value);
bool fromStringValue(const std::string &inStr, bool       &value);
bool fromStringValue(const std::string &inStr, float      &value);
bool fromStringValue(const std::string &inStr, double     &value);

template<typename T>
bool fromStringValue(const std::string &inStr, std::optional<T> &oValue)
{
    return fromStringValue(inStr, oValue.value());
}

template<typename T>
bool fromStringValue(const std::vector<std::string> &inStr,
                     std::vector<T> &value)
{
    try
    {
        for (const auto & item : inStr)
        {
            T tmp{};
            if (fromStringValue(item, tmp))
                value.push_back(tmp);
        }
    }
    catch (...)
    {
        return false;
    }
    return !value.empty();
}

template<typename T>
bool fromStringValue(const std::string &inStr,
                     std::vector<T> &value,
                     char separator = ',')
{
    std::vector<std::string> parts;
    std::istringstream       ss(inStr);
    std::string              s;
    while (std::getline(ss, s, separator))
        parts.push_back(s);

    return fromStringValue(parts, value);
}


// HELPER TO PARSE DROGON HEADERS
inline std::string safe_at(const drogon::SafeStringMap<std::string> &drogonHeaders, const std::string &key)
{
    if(auto it = drogonHeaders.find(key); it != drogonHeaders.end())
    {
        return it->second;
    }
    return "";
}

/// STRUCTURE WRAPPER FOR RAW STRING
struct RawResponse
{
    RawResponse() = default;
    explicit RawResponse(drogon::HttpResponsePtr resp) : resp(std::move(resp)) {};
    explicit RawResponse(std::string&& string)
    {
        resp = drogon::HttpResponse::newHttpResponse();
        resp->setBody(std::move(string));
    }
    [[nodiscard]] std::string_view stringView() const { return resp->getBody(); }
    [[nodiscard]] std::string copy() const { return std::string(resp->getBody()); }

    drogon::HttpResponsePtr getPtr() const { return resp; }

    private:
    drogon::HttpResponsePtr resp;
};


/// PATH
inline void replaceAll(std::string& str, const std::string& from, const std::string &to)
{
    if (from.empty()) return;
    size_t start_pos = 0;
    while ((start_pos = str.find(from, start_pos)) != std::string::npos)
    {
        str.replace(start_pos, from.length(), to);
        start_pos += to.length();
    }
}

// from /path/{1} to /path/pathParam?queryName=queryParam&...
template <size_t pathN, size_t queryN>
std::string formatClientPath(
    std::string pathWithoutQuery,
    const std::array<std::pair<std::string, std::string>, pathN>& pathParameters,
    const std::array<std::pair<std::string, std::string>, queryN>& queryParameters)
{
    size_t idx = 1;
    for (const auto& [pathParamName, pathParam] : pathParameters)
    {
        // Remplace {1}, {2}, ...
        replaceAll(pathWithoutQuery, "{" + toStringValue(idx++) + "}", pathParam);
    }

    if constexpr (queryN > 0) {
        pathWithoutQuery.push_back('?');
        for (size_t i = 0; i < queryParameters.size(); ++i)
        {
            const auto& [queryParamName, queryParam] = queryParameters[i];
            if (i > 0) pathWithoutQuery.push_back('&');
            pathWithoutQuery.append(queryParamName)
                            .append("=")
                            .append(queryParam);
        }
    }

    return pathWithoutQuery;
}


